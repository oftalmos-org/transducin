# ── Orthanc PACS ─────────────────────────────────────────────────────────────
# Never hardcode IPs — always configure via .env
ORTHANC_HOST=your-orthanc-host-or-ip
ORTHANC_PORT=4242
ORTHANC_HTTP_PORT=8042
ORTHANC_HTTP_USER=your-username
ORTHANC_HTTP_PASS=your-password
ORTHANC_AET=ORTHANC
TRANSDUCIN_AET=TRANSDUCIN

# ── Revo FC130 watcher (revo_watcher.py) ─────────────────────────────────────
REVO_WATCH_FOLDER=input/REVO
REVO_OUTPUT_DIR=Output/revo
REVO_LOG_DIR=logs
REVO_SETTLE_DELAY=2
# Esperar hasta que Revo termine la segmentación AI antes de procesar.
# Sin esto, el .opt se captura en su quick-save inicial (sin capas) y
# los SRs salen vacíos (CMT=N/A, ETDRS=N/A, RNFL=N/A).
REVO_SEG_WAIT_TIMEOUT=180
REVO_SEG_POLL_INTERVAL=5

# ── PTS 925Wi Orthanc poller (pts925_watcher.py) ─────────────────────────────
# Polls Orthanc for OPV studies without paired SR, generates and uploads SR.
# No filesystem dependency — PTS 925Wi sends DICOM OPV directly to Orthanc.
PTS_POLL_INTERVAL_SECONDS=300
PTS_SR_OUTPUT_DIR=
PTS925_LOG_DIR=logs

# ── NOEL resolver (SOCT.db patient registry) ────────────────────────────────
# Revo SOCT database with authoritative patient IDs (ref field = NOEL ID)
SOCT_DB_PATH=C:\SOCT_DATA\SOCT.db

# ── SR quality ───────────────────────────────────────────────────────────────
# Signal Quality Index warning threshold (scale 0-10, default 6)
TRANSDUCIN_SQI_MIN_WARN=6

# ── API / pgvector (optional) ────────────────────────────────────────────────
# TRANSDUCIN_API_PORT=8004
# TRANSDUCIN_EMBEDDING_URL=
# TRANSDUCIN_EMBEDDING_DIM=768
# TRANSDUCIN_PGVECTOR_DSN=
